# ==========================================
# CẤU HÌNH SERVER NESTJS
# ==========================================
PORT=5000

# ==========================================
# CẤU HÌNH DATABASE (POSTGRESQL & PRISMA)
# ==========================================
# Cú pháp: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/course_db?schema=public"

# ==========================================
# CẤU HÌNH JWT (JSON WEB TOKEN)
# ==========================================
# Chuỗi bí mật ký Access Token (ngắn hạn)
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="15m"

# Chuỗi bí mật ký Refresh Token (dài hạn)
JWT_REFRESH_SECRET="your_refresh_jwt_secret_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"
